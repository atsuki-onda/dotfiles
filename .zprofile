# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:/Users/onda/.docker/bin"
# End of Docker Desktop section.

# Homebrew: put /opt/homebrew/bin ahead of /usr/bin so brew-installed
# tools (git, etc.) take precedence over the macOS-bundled versions.
eval "$(/opt/homebrew/bin/brew shellenv)"
